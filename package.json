{
  "name": "servigo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "web": "npm run dev --workspace=web",
    "mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  }
}